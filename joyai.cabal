cabal-version:      2.4
name:               joyai
version:            0.2.0.0
synopsis:           Joy AI — intonation-juxtaposed AI commentary art piece
description:
  A purely functional Haskell backend that ingests internet commentary
  about generative AI via Tavily, annotates it (sentiment score, plus an
  English translation for non-English comments) through an LLM engine,
  and streams structured payloads over WebSockets to a dual-avatar
  frontend. Comments are read aloud verbatim by a real animated human
  face whose intonation contradicts the sentiment: hate is read
  gleefully, praise mournfully.
license:            WTFPL
license-file:       LICENSE
author:             JoyAI
maintainer:         JoyAI
build-type:         Simple

common warnings
  ghc-options: -Wall
  default-language: Haskell2010

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Types
    Logic
    Network.Tavily
    Network.LLM
  build-depends:
      base >=4.14 && <5
    , aeson
    , bytestring
    , http-client
    , http-conduit
    , mtl
    , text

executable joyai
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.14 && <5
    , aeson
    , filepath
    , joyai
    , mtl
    , scotty
    , text
    , websockets
